# Copia este archivo a server/.env y ajusta los valores.

# --- Base de datos (la del docker-compose.yml del proyecto) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barberflow?schema=public"

# --- Seguridad ---
# OBLIGATORIO: firma los tokens de sesión. Mínimo 16 caracteres.
# Genera uno propio con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Con este valor de ejemplo la API arranca en desarrollo (con una advertencia),
# pero se niega a arrancar en producción (NODE_ENV=production).
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# --- Servidor ---
PORT=3001
CORS_ORIGIN="http://localhost:5173"
# Zona horaria del negocio: define "hoy", las horas de las citas y los días de las analíticas.
BUSINESS_TZ="America/Bogota"
# Número de proxies delante de la API (nginx, balanceador). Déjalo vacío si no hay ninguno.
# TRUST_PROXY=1

# --- Límites de peticiones por IP en 15 minutos (opcionales) ---
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=100

# --- Bootstrap del usuario master (solo se crea si no existe ningún master en la BD) ---
MASTER_EMAIL="admin@barberflow.com"
MASTER_PASSWORD="change-me-on-first-deploy"
MASTER_NAME="Administrador BarberFlow"
