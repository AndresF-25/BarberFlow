# Copia este archivo a .env en la raíz del proyecto.
# Lo leen Vite (solo las variables VITE_*, que son públicas) y docker compose.

# --- Frontend ---
# Ruta de la API. Con el proxy de Vite (desarrollo) o de nginx (Docker) basta la ruta relativa.
VITE_API_URL=/api/v1

# --- Solo para `docker compose --profile app up -d --build` ---
# OBLIGATORIO: genera uno con  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
POSTGRES_PASSWORD=postgres
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080
BUSINESS_TZ=America/Bogota
# Usuario master (solo se crea si aún no existe ninguno)
MASTER_EMAIL=
MASTER_PASSWORD=
